# 🌸 O pequeno caderno da Maomao
# Preencha com calma e nunca compartilhe este arquivo com seu token.
DISCORD_TOKEN=cole_o_token_do_bot_aqui
DISCORD_CLIENT_ID=id_da_aplicacao

# 🪻 Durante os testes, use o ID do seu servidor para registrar comandos mais rápido.
DISCORD_GUILD_ID=

# ✦ Registros e dados ficam nesta pasta; ela não deve ir para o GitHub.
LOG_LEVEL=info
DATA_DIR=./data

# 🏯 Preparação automática do Palácio das Ervas.
# Deixe false até conferir as permissões do bot e o ID do servidor.
MAOMAO_AUTO_SETUP=false
MAOMAO_AUTO_SETUP_GUILD_ID=
MAOMAO_SETUP_MODE=additive
